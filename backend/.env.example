# Optional for local dev (every value has a working default).
# DATABASE_URL=sqlite:///./airbnb.db            # default: local SQLite file
# DATABASE_URL=postgres://user:pass@host/db     # hosted Postgres (required on Vercel, e.g. Neon)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
